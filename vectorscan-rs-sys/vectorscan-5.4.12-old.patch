diff --git a/pristine/chimera/libch.pc.in b/modified/chimera/libch.pc.in
index 1eaf5bc..765cf24 100644
--- a/pristine/chimera/libch.pc.in
+++ b/modified/chimera/libch.pc.in
@@ -7,6 +7,6 @@ Name: libch
 Description: Intel(R) Chimera Library
 Version: @HS_VERSION@
 Requires.private: libhs
-Libs: -L${libdir} -lchimera
+Libs: -L${libdir} -lchimera -lpcre -lstdc++ -lm
 Libs.private: @PRIVATE_LIBS@
 Cflags: -I${includedir}/hs
diff --git a/pristine/cmake/build_wrapper.sh b/modified/cmake/build_wrapper.sh
index d0a7e92..5521b75 100644
--- a/pristine/cmake/build_wrapper.sh
+++ b/modified/cmake/build_wrapper.sh
@@ -2,35 +2,56 @@
 # This is used for renaming symbols for the fat runtime, don't call directly
 # TODO: make this a lot less fragile!
 cleanup () {
-    rm -f ${SYMSFILE} ${KEEPSYMS}
+    rm -f ${SYMSFILE} ${KEEPSYMS} ${LIBC_SYMS}
 }
 
+NM="${NM:-nm}"
+OBJCOPY="${OBJCOPY:-objcopy}"
+OBJDUMP="${OBJDUMP:-objdump}"
+
 PREFIX=$1
 KEEPSYMS_IN=$2
 shift 2
 # $@ contains the actual build command
-OUT=$(echo "$@" | rev | cut -d ' ' -f 2- | rev | sed 's/.* -o \(.*\.o\).*/\1/')
+OUT=$(echo "$@" | rev | cut -d ' ' -f 2- | rev | sed 's/.* -o \(.*\.obj\).*/\1/')
 trap cleanup INT QUIT EXIT
 SYMSFILE=$(mktemp -p /tmp ${PREFIX}_rename.syms.XXXXX)
 KEEPSYMS=$(mktemp -p /tmp keep.syms.XXXXX)
-# find the libc used by gcc
-LIBC_SO=$("$@" --print-file-name=libc.so.6)
+LIBC_SYMS=$(mktemp -p /tmp keep_libc.syms.XXXXX)
+# Use MinGW C runtime instead of libc.so.6
+# VECTORSCAN_LIBC_SO is set by the build function to the correct path for the environment
+LIBC_SO="${VECTORSCAN_LIBC_SO:-/usr/x86_64-w64-mingw32/lib/libcrtdll.a}"
 NM_FLAG="-f"
-if [ `uname` = "FreeBSD" ]; then
-    # for freebsd, we will specify the name, 
-    # we will leave it work as is in linux
-    LIBC_SO=/lib/libc.so.7
-    # also, in BSD, the nm flag -F corresponds to the -f flag in linux.
-    NM_FLAG="-F"
-fi
 cp ${KEEPSYMS_IN} ${KEEPSYMS}
-# get all symbols from libc and turn them into patterns
-nm ${NM_FLAG} p -g -D ${LIBC_SO} | sed 's/\([^ @]*\).*/^\1$/' >> ${KEEPSYMS}
+# Extract C runtime symbols as plain names (no regex) for fixed-string matching.
+# Using grep -F avoids issues with symbols containing regex metacharacters (e.g. brackets
+# in libmsvcrt.a) that would cause "Invalid range end" errors with regex grep.
+${NM} ${NM_FLAG} posix -g ${LIBC_SO} | awk '{print $1}' >> ${LIBC_SYMS}
 # build the object
 "$@"
 # rename the symbols in the object
-nm ${NM_FLAG} p -g ${OUT} | cut -f1 -d' ' | grep -v -f ${KEEPSYMS} | sed -e "s/\(.*\)/\1\ ${PREFIX}_\1/" >> ${SYMSFILE}
+# First filter by keep.syms.in regex patterns, then by C runtime symbols (fixed-string match)
+${NM} ${NM_FLAG} posix -g ${OUT} | cut -f1 -d' ' | grep -v -f ${KEEPSYMS} | \
+    grep -F -x -v -f ${LIBC_SYMS} | \
+    sed "s/\(.*\)/\1 ${PREFIX}_\1/" >> ${SYMSFILE}
 if test -s ${SYMSFILE}
 then
-    objcopy --redefine-syms=${SYMSFILE} ${OUT}
+    ${OBJCOPY} --redefine-syms=${SYMSFILE} ${OUT}
+fi
+
+# Also rename .refptr sections to avoid COMDAT conflicts (MinGW-specific)
+SECTFILE=$(mktemp -p /tmp ${PREFIX}_sections.XXXXX)
+
+# Get list of .rdata$.refptr.* sections - use objdump -h to show section headers
+${OBJDUMP} -h ${OUT} 2>/dev/null | grep '\.rdata\$\.refptr\.' | awk '{print $2}' | while IFS= read -r sect; do
+    # Skip hs_* sections (shared API symbols that must not be renamed)
+    case "$sect" in
+        *.refptr.hs_*) continue ;;
+    esac
+    echo "--rename-section=${sect}=${PREFIX}_${sect}" >> ${SECTFILE}
+done 2>/dev/null
+
+if [ -s "${SECTFILE}" ]; then
+    ${OBJCOPY} $(cat ${SECTFILE}) ${OUT} 2>/dev/null
 fi
+rm -f "${SECTFILE}" 2>/dev/null
